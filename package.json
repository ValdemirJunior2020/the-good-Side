{
  "name": "the-good-side",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "check": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile": "npm run start -w @goodside/mobile",
    "api": "npm run dev -w @goodside/api",
    "research": "npm run research -w @goodside/research",
    "aihot:import": "npm run aihot:import -w @goodside/research"
  }
}
