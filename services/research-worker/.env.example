API_URL=http://localhost:8788
RESEARCH_WORKER_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# AIHOT Docker site URL; Node bridge reads the documented public v1 selected-items API
AIHOT_URL=http://127.0.0.1:3000
AIHOT_MIN_SCORE=60
AIHOT_MAX_ITEMS=50
AIHOT_ALLOW_REMOTE=false

# Ollama recipe discoverer writes 5 pending drafts daily. Never auto-publishes.
# Set API_URL to your running backend and RESEARCH_WORKER_KEY to the same secret as API.
# TheMealDB developer key 1 is only for development; obtain provider licensing before release.
